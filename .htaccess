Options -Indexes

# ── Block direct browser access to sensitive files ────────────────────────

<FilesMatch "^config\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to all .credentials.php files anywhere
<FilesMatch "\.credentials\.php$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Block access to the entire data directory
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block data/ directory requests
    RewriteRule ^data(/.*)?$ - [F,L]

    # Optional: redirect non-www to www (uncomment if needed)
    # RewriteCond %{HTTP_HOST} !^www\. [NC]
    # RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>

# ── Security Headers ──────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
